<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.details.after.wrapper.main">
            <block class="Magento\Framework\View\Element\Template" name="product.comments.wrapper" after="product.reviews.wrapper" template="Magento_PageBuilder::catalog/product/view/section_wrapper.phtml">
                <block class="Iovista\ProductComment\Block\Product\Comment" name="product.comments.tab" as="productComments" template="Iovista_ProductComment::product_comment.phtml" group="detailed_info" ifconfig="catalog/productComment/active">
                    <arguments>
                        <argument name="sort_order" xsi:type="string">100</argument>
                    </arguments>
                    <block class="Iovista\ProductComment\Block\Form" name="product.comment.form" as="comment_form" ifconfig="catalog/productComment/active">
                        <arguments>
                            <argument name="button_lock_manager" xsi:type="object">Magento\Framework\View\Element\ButtonLockManager</argument>
                        </arguments>
                    </block>
                </block>
                <arguments>
                    <argument name="title" translate="true" xsi:type="string">Comments</argument>
                    <argument name="section_id" xsi:type="string">productComments</argument>
                </arguments>
<!--                <block class="Magento\Review\Block\Product\View\ListView" name="product.info.product_additional_data.wrapper" template="Magento_Review::product/view/list.phtml" ifconfig="catalog/review/active">-->
<!--                    <arguments>-->
<!--                        <argument name="hide_title" xsi:type="boolean">true</argument>-->
<!--                    </arguments>-->
<!--                </block>-->
            </block>
        </referenceContainer>
    </body>
</page>
