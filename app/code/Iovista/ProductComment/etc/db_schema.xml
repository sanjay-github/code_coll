<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="product_comment" resource="default" engine="innodb" comment="Product comment information">
        <column xsi:type="bigint" name="comment_id" unsigned="true" nullable="false" identity="true"
                comment="Comment ID"/>
        <column xsi:type="varchar" name="nickname" nullable="false" length="128" comment="Name"/>
        <column xsi:type="varchar" name="email" nullable="false" length="128" comment="Email"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" identity="false"
                default="0" comment="Product ID"/>
        <column xsi:type="varchar" name="comment" nullable="false" comment="Comment"/>
        <column xsi:type="smallint" name="status" unsigned="true" nullable="false" identity="false"
                default="0" comment="Status"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created date"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="comment_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PRODUCT_COMMENT_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_IDREVIEW_ENTITY_ID_REVIEW_ENTITY_ENTITY_ID" table="product_comment" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="PRODUCT_COMMENT_COMMENT_ID" indexType="btree">
            <column name="comment_id"/>
        </index>
        <index referenceId="PRODUCT_COMMENT" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="PRODUCT_COMMENT_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
    </table>
</schema>
